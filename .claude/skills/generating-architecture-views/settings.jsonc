// generating-architecture-views 설정
// 키와 값은 영어로 적고, 설명은 각 옵션 위 주석을 보세요.
// 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선합니다.
{
  "responsibility": {
    // Responsibility 섹션을 어떻게 보여줄지
    //   hidden    : 섹션을 그리지 않음 — 토큰 소모 줄어듦
    //   plain     : 상자 없이 그대로 — 토큰 소모 영향 거의 없음
    //   collapsed : 접은 글 상자에 넣고 처음엔 접힘 — 토큰 소모 영향 거의 없음
    //   expanded  : 접은 글 상자에 넣고 처음엔 펼침 — 토큰 소모 영향 거의 없음
    //   (기본값: collapsed)
    "display": "collapsed"
  },
  "collaboration": {
    // Collaboration 섹션을 어떻게 보여줄지
    //   hidden    : 섹션을 그리지 않음 — 토큰 소모 줄어듦
    //   plain     : 상자 없이 그대로 — 토큰 소모 영향 거의 없음
    //   collapsed : 접은 글 상자에 넣고 처음엔 접힘 — 토큰 소모 영향 거의 없음
    //   expanded  : 접은 글 상자에 넣고 처음엔 펼침 — 토큰 소모 영향 거의 없음
    //   (기본값: collapsed)
    "display": "collapsed"
  },
  "dependency": {
    // Dependency 다이어그램을 그릴 Mermaid 레이아웃 엔진
    //   default : 따로 지정하지 않음 — 보는 곳의 기본 엔진을 따름(VS Code 미리보기·PNG/PDF 내보내기 모두 Mermaid 12라 지금은 ELK, 다만 보는 곳의 Mermaid가 바뀌면 달라질 수 있음) — 토큰 소모 영향 거의 없음
    //   elk     : ELK 엔진으로 그림(보는 곳의 기본값과 무관하게 항상 ELK) — 토큰 소모 영향 거의 없음
    //   (기본값: elk)
    "renderer": "elk"
  }
}
