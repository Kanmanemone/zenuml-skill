// generating-zenuml-diagrams 설정
// 키와 값은 영어로 적고, 설명은 각 옵션 위 주석을 보세요.
// 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선합니다.
{
  "log": {
    // 피드백 로그(다이어그램을 다시 만들 때마다 요청과 결과를 쌓는 기록)를 저장할 위치
    //   허용: 프로젝트 루트 기준 상대 경로(예: ./.zenuml/log, ./docs/diagram-logs). 절대 경로는 안 됨 — 영향 거의 없음
    //   (기본값: ./.zenuml/log)
    "directory": "./.zenuml/log"
  }
}
