{
  "options": [
    {
      "key": "questions.enabled",
      "type": "boolean",
      "default": true,
      "description": "형식·범위·PDF 레이아웃이 요청에 없을 때 선택지 질문으로 물을지",
      "tokenImpact": {
        "true": "토큰 소모 영향 거의 없음",
        "false": "토큰 소모 줄어듦"
      }
    },
    {
      "key": "defaults.format",
      "type": "enum",
      "values": [
        "none",
        "svg",
        "png",
        "pdf"
      ],
      "default": "png",
      "description": "요청이 출력 형식을 밝히지 않았을 때의 기본 형식 (none = 기본값 없음)",
      "tokenImpact": {
        "none": "토큰 소모 영향 거의 없음",
        "svg": "토큰 소모 영향 거의 없음",
        "png": "토큰 소모 영향 거의 없음",
        "pdf": "토큰 소모 영향 거의 없음"
      }
    },
    {
      "key": "defaults.scope",
      "type": "enum",
      "values": [
        "none",
        "diagram",
        "document"
      ],
      "default": "document",
      "description": "요청이 변환 범위를 밝히지 않았을 때의 기본 범위 (none = 기본값 없음)",
      "tokenImpact": {
        "none": "토큰 소모 영향 거의 없음",
        "diagram": "토큰 소모 영향 거의 없음",
        "document": "토큰 소모 영향 거의 없음"
      }
    },
    {
      "key": "defaults.pdfLayout",
      "type": "enum",
      "values": [
        "none",
        "single",
        "paginated"
      ],
      "default": "single",
      "description": "문서 전체 PDF에서 요청이 페이지 구성을 밝히지 않았을 때의 기본값 (none = 기본값 없음)",
      "tokenImpact": {
        "none": "토큰 소모 영향 거의 없음",
        "single": "토큰 소모 영향 거의 없음",
        "paginated": "토큰 소모 영향 거의 없음"
      }
    },
    {
      "key": "png.scale",
      "type": "number",
      "min": 0,
      "default": 3,
      "description": "PNG 해상도 배율 (0보다 큰 수, 클수록 선명하고 파일이 큼)",
      "tokenImpact": {
        "*": "토큰 소모 영향 거의 없음"
      }
    },
    {
      "key": "output.directory",
      "type": "relativePath",
      "base": "sourceFileDir",
      "default": "./exports",
      "description": "변환 결과를 저장할 위치 (원본 마크다운 파일이 있는 폴더 기준 상대 경로)",
      "tokenImpact": {
        "*": "토큰 소모 영향 거의 없음"
      }
    }
  ]
}
