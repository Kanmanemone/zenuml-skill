// exporting-markdown-diagrams 설정
// 키와 값은 영어로 적고, 설명은 각 옵션 위 주석을 보세요.
// 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선합니다.
{
  "questions": {
    // 형식·범위·PDF 레이아웃이 요청에 없을 때 선택지 질문으로 물을지
    //   true  : 물어봄. 아래 defaults와 같은 선택지 끝에 " (기본값)"이 붙음 — 영향 거의 없음
    //   false : 묻지 않고 아래 defaults로 진행(defaults가 none인 항목만 물어봄) — 토큰 소모 줄어듦
    //   (기본값: true)
    "enabled": true
  },
  "defaults": {
    // 요청이 출력 형식을 밝히지 않았을 때의 기본 형식
    //   none : 기본값 없음 — 영향 거의 없음
    //   svg  : SVG 벡터 이미지 — 영향 거의 없음
    //   png  : PNG 이미지 — 영향 거의 없음
    //   pdf  : PDF 문서 — 영향 거의 없음
    //   (기본값: png)
    "format": "png",

    // 요청이 변환 범위를 밝히지 않았을 때의 기본 범위
    //   none     : 기본값 없음 — 영향 거의 없음
    //   diagram  : 다이어그램만 — 영향 거의 없음
    //   document : 문서 전체(항상 PDF) — 영향 거의 없음
    //   (기본값: document)
    "scope": "document",

    // 문서 전체 PDF에서 요청이 페이지 구성을 밝히지 않았을 때의 기본값
    //   none      : 기본값 없음 — 영향 거의 없음
    //   single    : 1페이지 단일(페이지 나눔 없음) — 영향 거의 없음
    //   paginated : 표준 인쇄 규격(A4로 나눔) — 영향 거의 없음
    //   (기본값: single)
    "pdfLayout": "single"
  },
  "png": {
    // PNG 해상도 배율
    //   허용: 0보다 큰 수(클수록 선명하고 파일이 큼) — 영향 거의 없음
    //   (기본값: 3)
    "scale": 3
  },
  "output": {
    // 변환 결과를 저장할 위치
    //   허용: 원본 마크다운 파일이 있는 폴더 기준 상대 경로(예: ./exports, ../out). 절대 경로는 안 됨 — 영향 거의 없음
    //   (기본값: ./exports)
    "directory": "./exports"
  }
}
