// exporting-markdown-diagrams 설정 — 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선
// 토큰 소모(초기 기본값 대비): [-] 줄어듦  [0] 거의 같음  [+] 늘어남  [++] 큼
{
  "questions": {
    // 형식·범위·PDF 레이아웃이 요청에 없을 때 선택지 질문으로 물을지 (초기 기본값: true)
    //   true  [0] 물어봄, 아래 defaults에 설정한 값의 선택지에 " (기본값)" 표시
    //   false [-] 묻지 않고 defaults로 진행(none인 항목만 물어봄)
    "enabled": true
  },
  "defaults": {
    // 요청에 출력 형식이 없을 때의 기본 형식, 문서 전체에는 pdf·png만 적용 (초기 기본값: png)
    //   none [0] 기본값 없음
    //   svg  [0] SVG 벡터 이미지
    //   png  [0] PNG 이미지
    //   pdf  [0] PDF 문서
    "format": "png",

    // 요청에 변환 범위가 없을 때의 기본 범위 (초기 기본값: document)
    //   none     [0] 기본값 없음
    //   diagram  [0] 다이어그램만
    //   document [0] 문서 전체(PDF 또는 PNG)
    "scope": "document",

    // 문서 전체(PDF·PNG)에서 요청에 페이지 구성이 없을 때의 기본값 (초기 기본값: single)
    //   none      [0] 기본값 없음
    //   single    [0] 나누지 않은 한 페이지(PNG면 긴 이미지 한 장)
    //   paginated [0] A4로 나눔(PNG면 페이지마다 한 장)
    "pdfLayout": "single"
  },
  "png": {
    // PNG 해상도 배율 (초기 기본값: 3)
    //   허용 [0] 0보다 큰 수, 클수록 선명하고 파일이 큼
    "scale": 3
  },
  "output": {
    // 변환 결과를 저장할 위치 (초기 기본값: ./exports)
    //   허용 [0] 원본 마크다운 파일 폴더 기준 상대 경로(예: ./exports), 절대 경로는 안 됨
    "directory": "./exports"
  }
}
