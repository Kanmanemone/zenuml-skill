// generating-architecture-views 설정 — 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선
// 토큰 소모(초기 기본값 대비): [-] 줄어듦  [0] 거의 같음  [+] 늘어남  [++] 큼
{
  "responsibility": {
    // Responsibility 섹션을 어떻게 보여줄지 (초기 기본값: collapsed)
    //   hidden    [-] 그리지 않음
    //   plain     [0] 상자 없이 그대로
    //   collapsed [0] 접은 글 상자, 처음엔 접힘
    //   expanded  [0] 접은 글 상자, 처음엔 펼침
    "display": "collapsed"
  },
  "collaboration": {
    // Collaboration 섹션을 어떻게 보여줄지 (초기 기본값: collapsed)
    //   hidden    [-] 그리지 않음
    //   plain     [0] 상자 없이 그대로
    //   collapsed [0] 접은 글 상자, 처음엔 접힘
    //   expanded  [0] 접은 글 상자, 처음엔 펼침
    "display": "collapsed",

    // 협력마다 "내가 할 수 있는 질문"을 만들지 (초기 기본값: false)
    //   true  [+] 만듦
    //   false [0] 만들지 않음(hover에도 질문이 뜨지 않음)
    "questions": false
  },
  "dependency": {
    // Dependency 다이어그램을 그릴 Mermaid 레이아웃 엔진 (초기 기본값: elk)
    //   default [0] 지정 안 함, 보는 곳의 기본 엔진을 따름(지금 Mermaid 12는 ELK)
    //   elk     [0] 항상 ELK
    "renderer": "elk",

    // Dependency 노드 이름의 출력 형식
    "nodeNameFormat": {
      // 파일 내부 선언에 원본 선언 키워드를 표시할지 (초기 기본값: false)
      //   true  [+] 표시함(class Foo, val bar)
      //   false [0] 표시하지 않음(Foo, bar)
      "declarationMarkers": false,

      // 파일 자체를 가리키는 노드에 마지막 확장자를 표시할지 (초기 기본값: true)
      //   true  [0] 표시함(file.kt, file.c)
      //   false [0] 표시하지 않음(file)
      "fileExtensions": true,

      // 확인된 함수 노드 이름 끝에 ()를 표시할지 (초기 기본값: true)
      //   true  [0] 표시함(foo())
      //   false [0] 표시하지 않음(foo)
      "functionParentheses": true
    },

    // 노드가 나온 파일 이름을 노드 위쪽 테두리 선 위에 그 노드 테두리 색의 작은 기울임 글씨로 표시. 링크가 있는 노드만,
    // 파일 자체를 가리키는 노드는 제외. 저장 후 번들 스크립트가 채움
    "sourceFile": {
      // 표시할지 (초기 기본값: true)
      //   true  [0] 표시함
      //   false [0] 표시하지 않음
      "enabled": true,

      // 표시 위치 (초기 기본값: right)
      //   right  [0] 위쪽 테두리 오른쪽(끝에서 살짝 안쪽)
      //   center [0] 위쪽 테두리 가운데
      //   left   [0] 위쪽 테두리 왼쪽(끝에서 살짝 안쪽)
      "position": "right"
    },

    // 라벨이 생성·전달·타입 참조인 간선(사용 외 의존)을 출발 노드 색을 옅게 한 선으로 진한 선 아래에 그리고,
    // 범례에 "옅은 간선: 사용 외 의존 (생성·전달 등)" 한 줄을 붙일지. 저장 후 번들 스크립트가 채움 (초기 기본값: true)
    //   true  [0] 옅게 그림
    //   false [0] 모든 간선을 진한 선으로 그림
    "faintNonUsageEdges": true,

    // 링크가 있는 노드 이름의 모양, 눌러서 여는 동작은 그대로 (초기 기본값: plain)
    //   plain [0] 링크가 없는 것처럼 원래 글자색, 밑줄 없음(마우스를 올리면 밑줄)
    //   link  [0] 보는 곳의 링크 색(보통 파란색)과 밑줄
    "linkStyle": "plain"
  },
  "log": {
    // 피드백 로그(다시 만들 때마다 요청과 결과를 쌓는 기록)를 저장할 위치 (초기 기본값: ./.zenuml/log)
    //   허용 [0] 프로젝트 루트 기준 상대 경로, 절대 경로는 안 됨
    "directory": "./.zenuml/log"
  },
  "hover": {
    // 노드에 마우스를 올리면 뜨는 창(hover 패널). VS Code Markdown 미리보기 전용이고,
    // 저장 후 번들 스크립트가 채움(Python 3.9 이상, 없으면 창만 빠짐).
    // 위 display가 hidden인 섹션은 빈 목록으로 동작하고, 두 목록이 모두 비면 기능이 꺼짐.

    // 기능 전체를 켤지, 아래 항목 설정은 그대로 둠 (초기 기본값: true)
    //   true  [0] 켬
    //   false [0] 끔(도입 전과 같은 산출물)
    "enabled": true,

    // 넣을 Responsibility 항목, 적은 순서대로 표시 (초기 기본값: ["abstract", "concrete"])
    //   abstract [0] 책임 (추상)
    //   concrete [0] 역할 (구체)
    "responsibility": ["abstract", "concrete"],

    // 그 노드가 의존하는 협력마다 넣을 항목, 적은 순서대로 표시 (초기 기본값: ["targets", "boundary", "rationale", "questions"])
    //   targets   [0] 의존 대상과 관계(빼도 협력 구분용으로 항상 붙음)
    //   boundary  [0] 책임의 경계
    //   rationale [0] 분리 이유 & 합리성 평가
    //   questions [0] 내가 할 수 있는 질문(위 collaboration.questions가 false면 뜨지 않음)
    "collaboration": ["targets", "boundary", "rationale", "questions"],

    // 창의 위치 (초기 기본값: bottom)
    //   bottom [0] 미리보기 아래 넓은 고정 패널(넓으면 여러 칸)
    //   node   [0] 노드 바로 아래(폭 최대 25em)
    "position": "bottom"
  }
}
