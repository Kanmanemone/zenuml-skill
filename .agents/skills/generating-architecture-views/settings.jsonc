// generating-architecture-views 설정 — 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선
// 토큰 소모(초기 기본값 대비): [-] 줄어듦  [0] 거의 같음  [+] 늘어남  [++] 큼
{
  "responsibility": {
    // Responsibility 섹션을 어떻게 보여줄지 (초기 기본값: collapsed)
    //   hidden    [-] 그리지 않음
    //   plain     [0] 상자 없이 그대로
    //   collapsed [0] 접은 글 상자, 처음엔 접힘
    //   expanded  [0] 접은 글 상자, 처음엔 펼침
    "display": "collapsed"
  },
  "collaboration": {
    // Collaboration 섹션을 어떻게 보여줄지 (초기 기본값: collapsed)
    //   hidden    [-] 그리지 않음
    //   plain     [0] 상자 없이 그대로
    //   collapsed [0] 접은 글 상자, 처음엔 접힘
    //   expanded  [0] 접은 글 상자, 처음엔 펼침
    "display": "collapsed",

    // 협력마다 "내가 할 수 있는 질문"을 만들지 (초기 기본값: false)
    //   true  [+] 만듦
    //   false [0] 만들지 않음(hover에도 질문이 뜨지 않음)
    "questions": false
  },
  "dependency": {
    // Dependency 다이어그램을 그릴 Mermaid 레이아웃 엔진 (초기 기본값: elk)
    //   default [0] 지정 안 함, 보는 곳의 기본 엔진을 따름(지금 Mermaid 12는 ELK)
    //   elk     [0] 항상 ELK
    "renderer": "elk"
  },
  "log": {
    // 피드백 로그(다시 만들 때마다 요청과 결과를 쌓는 기록)를 저장할 위치 (초기 기본값: ./.zenuml/log)
    //   허용 [0] 프로젝트 루트 기준 상대 경로, 절대 경로는 안 됨
    "directory": "./.zenuml/log"
  },
  "hover": {
    // 노드에 마우스를 올리면 뜨는 창(hover 패널). VS Code Markdown 미리보기 전용이고,
    // 저장 후 번들 스크립트가 채움(Python 3.9 이상, 없으면 창만 빠짐).
    // 위 display가 hidden인 섹션은 빈 목록으로 동작하고, 두 목록이 모두 비면 기능이 꺼짐.

    // 기능 전체를 켤지, 아래 항목 설정은 그대로 둠 (초기 기본값: true)
    //   true  [0] 켬
    //   false [0] 끔(도입 전과 같은 산출물)
    "enabled": true,

    // 넣을 Responsibility 항목, 적은 순서대로 표시 (초기 기본값: ["abstract", "concrete"])
    //   abstract [0] 책임 (추상)
    //   concrete [0] 역할 (구체)
    "responsibility": ["abstract", "concrete"],

    // 그 노드가 의존하는 협력마다 넣을 항목, 적은 순서대로 표시 (초기 기본값: ["targets", "boundary", "rationale", "questions"])
    //   targets   [0] 의존 대상과 관계(빼도 협력 구분용으로 항상 붙음)
    //   boundary  [0] 책임의 경계
    //   rationale [0] 분리 이유 & 합리성 평가
    //   questions [0] 내가 할 수 있는 질문(위 collaboration.questions가 false면 뜨지 않음)
    "collaboration": ["targets", "boundary", "rationale", "questions"],

    // 창의 위치 (초기 기본값: bottom)
    //   bottom [0] 미리보기 아래 넓은 고정 패널(넓으면 여러 칸)
    //   node   [0] 노드 바로 아래(폭 최대 25em)
    "position": "bottom"
  }
}
