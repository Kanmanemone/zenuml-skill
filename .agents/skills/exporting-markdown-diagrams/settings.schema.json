{
  "options": [
    {
      "key": "questions.enabled",
      "type": "boolean",
      "default": true,
      "description": "형식·범위·PDF 레이아웃이 요청에 없을 때 선택지 질문으로 물을지",
      "tokenImpact": {
        "true": "[0]",
        "false": "[-]"
      }
    },
    {
      "key": "defaults.format",
      "type": "enum",
      "values": [
        "none",
        "svg",
        "png",
        "pdf"
      ],
      "default": "png",
      "description": "요청이 출력 형식을 밝히지 않았을 때의 기본 형식 (none = 기본값 없음, 문서 전체에는 svg를 쓸 수 없어 pdf·png만 적용됨)",
      "tokenImpact": {
        "none": "[0]",
        "svg": "[0]",
        "png": "[0]",
        "pdf": "[0]"
      }
    },
    {
      "key": "defaults.scope",
      "type": "enum",
      "values": [
        "none",
        "diagram",
        "document"
      ],
      "default": "document",
      "description": "요청이 변환 범위를 밝히지 않았을 때의 기본 범위 (none = 기본값 없음, document = 문서 전체 PDF 또는 PNG)",
      "tokenImpact": {
        "none": "[0]",
        "diagram": "[0]",
        "document": "[0]"
      }
    },
    {
      "key": "defaults.pdfLayout",
      "type": "enum",
      "values": [
        "none",
        "single",
        "paginated"
      ],
      "default": "single",
      "description": "문서 전체(PDF·PNG)에서 요청이 페이지 구성을 밝히지 않았을 때의 기본값 (none = 기본값 없음)",
      "tokenImpact": {
        "none": "[0]",
        "single": "[0]",
        "paginated": "[0]"
      }
    },
    {
      "key": "png.scale",
      "type": "number",
      "min": 0,
      "default": 3,
      "description": "PNG 해상도 배율 (0보다 큰 수, 클수록 선명하고 파일이 큼)",
      "tokenImpact": {
        "*": "[0]"
      }
    },
    {
      "key": "output.directory",
      "type": "relativePath",
      "base": "sourceFileDir",
      "default": "./exports",
      "description": "변환 결과를 저장할 위치 (원본 마크다운 파일이 있는 폴더 기준 상대 경로)",
      "tokenImpact": {
