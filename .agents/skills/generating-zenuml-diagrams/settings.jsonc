// generating-zenuml-diagrams 설정 — 요청 문장에서 다르게 말하면 그 요청에서는 말한 쪽이 우선
// 토큰 소모(초기 기본값 대비): [-] 줄어듦  [0] 거의 같음  [+] 늘어남  [++] 큼
{
  "log": {
    // 피드백 로그(다시 만들 때마다 요청과 결과를 쌓는 기록)를 저장할 위치 (초기 기본값: ./.zenuml/log)
    //   허용 [0] 프로젝트 루트 기준 상대 경로, 절대 경로는 안 됨
    "directory": "./.zenuml/log"
  },
  "diagram": {
    // 시퀀스 다이어그램을 어떤 모양으로 그릴지 (초기 기본값: readable)
    //   readable       [0] 읽기 쉽게 다듬은 모양: VS Code 코드 색 관례의 글자색, 글자 배경, 조건문 간격 등
    //   zenuml-default [0] 아무것도 더하지 않은 Mermaid·ZenUML 기본 렌더링
    "style": "readable"
  }
}
